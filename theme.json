{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"name": "Blue",
					"slug": "blue",
					"color": "#0587BF"
				},
				{
					"name": "Grey",
					"slug": "grey",
					"color": "#b2b2b2"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Lato",
					"slug": "lato",
					"fontFamily": "'Lato', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Lato",
							"fontStyle": "normal",
							"fontWeight": "100",
							"src": [ "file:./fonts/lato-v23-latin-ext-100.woff2" ]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "italic",
							"fontWeight": "100",
							"src": [ "file:./fonts/lato-v23-latin-ext-100italic.woff2" ]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "normal",
							"fontWeight": "300",
							"src": [ "file:./fonts/lato-v23-latin-ext-300.woff2" ]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "italic",
							"fontWeight": "300",
							"src": [ "file:./fonts/lato-v23-latin-ext-300italic.woff2" ]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [ "file:./fonts/lato-v23-latin-ext-regular.woff2" ]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [ "file:./fonts/lato-v23-latin-ext-italic.woff2" ]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [ "file:./fonts/lato-v23-latin-ext-700.woff2" ]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [ "file:./fonts/lato-v23-latin-ext-700italic.woff2" ]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "normal",
							"fontWeight": "900",
							"src": [ "file:./fonts/lato-v23-latin-ext-900.woff2" ]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "italic",
							"fontWeight": "900",
							"src": [ "file:./fonts/lato-v23-latin-ext-900italic.woff2" ]
						}
					]
				},
				{
					"name": "PT Serif",
					"slug": "pt-serif",
					"fontFamily": "'PT Serif', serif",
					"fontFace": [
						{
							"fontFamily": "PT Serif",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [ "file:./fonts/pt-serif-v17-latin-ext-regular.woff2" ]
						},
						{
							"fontFamily": "PT Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [ "file:./fonts/pt-serif-v17-latin-ext-italic.woff2" ]
						},
						{
							"fontFamily": "PT Serif",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [ "file:./fonts/pt-serif-v17-latin-ext-700.woff2" ]
						},
						{
							"fontFamily": "PT Serif",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [ "file:./fonts/pt-serif-v17-latin-ext-700italic.woff2" ]
						}
					]
				}
			]
		},
		"layout": {
			"contentSize": "700px",
			"allowEditing": false
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|pt-serif",
			"fontSize": "1.8rem",
			"lineHeight": "1.5"
		},
		"color": {
			"text": "hsl(0, 0%, 25%)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|lato",
					"fontWeight": "900"
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var:preset|font-family|lato"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"fontFamily": "var:preset|font-family|pt-serif",
					"fontSize": "2rem",
					"lineHeight": "1.6"
				}
			}
		}
	}
}
